{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: Release Mode",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/build.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build: Debug Mode",
            "type": "shell",
            "command": "python3 ${workspaceFolder}/build.py -e only_down_deps=true && mkdir -p build && cd build && cmake .. -DCMAKE_BUILD_TYPE=Debug && make -j$(nproc)",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Test: Build Unit Tests",
            "type": "shell",
            "command": "python3 ${workspaceFolder}/build.py -e only_down_deps=true && mkdir -p build && cd build && cmake .. -DBUILD_TESTS=ON -DCMAKE_BUILD_TYPE=Debug && make -j8",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "group": "build"
        },
        {
            "label": "Test: Run Unit Tests",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/build.py",
                "test"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Clean: All Workspace",
            "type": "shell",
            "command": "find build -mindepth 1 -maxdepth 1 ! -name '*.sh' ! -name 'build.py' -exec rm -rf {} + ; find output -mindepth 1 ! -path 'output/bin/msmemscope' ! -path 'output/bin' -exec rm -rf {} + ; rm -rf build_ut artifacts",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            }
        }
    ]
}
